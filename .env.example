# ─────────────────────────────────────────────────────────────
# LiftIQ — variables de entorno
#
# Copia este fichero a `.env` y rellena los valores:
#     cp .env.example .env
#
# Todo lo que empieza por EXPO_PUBLIC_ queda EMBEBIDO EN EL BUNDLE
# de la app y es visible para cualquiera que la descargue. Por eso
# aquí solo va la clave "anon" de Supabase, que está diseñada para
# ser pública y queda contenida por las políticas RLS.
#
# NUNCA pongas aquí la service_role key ni secretos de OAuth.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Panel de Supabase → Project Settings → Data API / API Keys
#
# Para desarrollo local con `npx supabase start`, la CLI imprime
# la URL y la anon key al arrancar. Valores por defecto locales:
#   URL = http://127.0.0.1:54321
#   (en un emulador Android usa http://10.0.2.2:54321,
#    y en un dispositivo físico la IP LAN de tu PC, p.ej.
#    http://192.168.1.50:54321)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Sign-In ──────────────────────────────────────────
# Las credenciales de Google NO van aquí: van en el panel de
# Supabase. La app solo abre el flujo OAuth que hospeda Supabase,
# así que no necesita conocer ningún client ID.
#
# Configuración, una sola vez:
#
#   1. Google Cloud Console → APIs & Services → Credentials →
#      Create OAuth client ID → tipo "Web application".
#      En "Authorized redirect URIs" pon la callback de Supabase:
#         https://<tu-proyecto>.supabase.co/auth/v1/callback
#
#   2. Supabase → Authentication → Providers → Google:
#      pega el Client ID y el Client Secret y actívalo.
#
#   3. Supabase → Authentication → URL Configuration →
#      Redirect URLs: añade  liftiq://  (el scheme de la app,
#      definido en app.json). Sin esto el navegador completa el
#      login pero no sabe cómo devolver el control a la app.
#
# Pon esto a "true" cuando hayas terminado los 3 pasos: es lo
# único que controla si aparece el botón de Google en el login.
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
